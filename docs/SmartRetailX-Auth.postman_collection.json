{
  "info": {
    "name": "SmartRetailX Auth Flow",
    "description": "Register → login → access protected order → 403 on wrong role",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "customerAccessToken", "value": "" },
    { "key": "productId", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "1. Register customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registered', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "pm.collectionVariables.set('customerAccessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"shopper@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Shopper\",\n  \"role\": \"customer\"\n}"
        },
        "url": "{{baseUrl}}/users/api/v1/auth/register"
      }
    },
    {
      "name": "2. Login customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logged in', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "pm.collectionVariables.set('customerAccessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"shopper@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/users/api/v1/auth/login"
      }
    },
    {
      "name": "3. Create order (customer — allowed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order created or upstream dependency', function () {",
              "  pm.expect([201, 400, 502]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1 }],\n  \"paymentMethod\": \"card\"\n}"
        },
        "url": "{{baseUrl}}/orders/api/v1/orders"
      }
    },
    {
      "name": "4. Catalogue mutate as customer — expect 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Forbidden for customer', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Should Fail\"\n}"
        },
        "url": "{{baseUrl}}/catalogue/api/v1/categories"
      }
    },
    {
      "name": "5. Refresh tokens",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refreshed', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/users/api/v1/auth/refresh"
      }
    },
    {
      "name": "6. Orders without token — expect 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unauthorized', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders/api/v1/orders"
      }
    }
  ]
}
