{
  "info": {
    "name": "SmartRetailX Full API",
    "description": "Happy paths + key error cases across gateway, user, catalogue, orders, inventory, payment, notification. Run with Newman for CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "inventoryUrl", "value": "http://localhost:3005" },
    { "key": "paymentUrl", "value": "http://localhost:3004" },
    { "key": "notificationUrl", "value": "http://localhost:3006" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "customerEmail", "value": "shopper+{{$timestamp}}@example.com" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Gateway metrics",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('metrics', () => { pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('http_requests_total'); });"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/metrics" }
        },
        {
          "name": "Inventory health",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{inventoryUrl}}/health" }
        },
        {
          "name": "Payment health",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{paymentUrl}}/health" }
        },
        {
          "name": "Notification health",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{notificationUrl}}/health" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Registered', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.collectionVariables.set('accessToken', b.accessToken);",
            "pm.collectionVariables.set('refreshToken', b.refreshToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\",\n  \"name\": \"Shopper\",\n  \"role\": \"customer\"\n}" },
            "url": "{{baseUrl}}/users/api/v1/auth/register"
          }
        },
        {
          "name": "Register duplicate — expect 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Conflict', () => pm.expect([409, 400]).to.include(pm.response.code));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\",\n  \"name\": \"Shopper\"\n}" },
            "url": "{{baseUrl}}/users/api/v1/auth/register"
          }
        },
        {
          "name": "Login invalid password — expect 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/users/api/v1/auth/login"
          }
        },
        {
          "name": "Login customer",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Logged in', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.collectionVariables.set('accessToken', b.accessToken);",
            "pm.collectionVariables.set('refreshToken', b.refreshToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/users/api/v1/auth/login"
          }
        },
        {
          "name": "Register admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Admin registered', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin+{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Admin\",\n  \"role\": \"admin\"\n}" },
            "url": "{{baseUrl}}/users/api/v1/auth/register"
          }
        },
        {
          "name": "Refresh tokens",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Refreshed', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.collectionVariables.set('accessToken', b.accessToken);",
            "pm.collectionVariables.set('refreshToken', b.refreshToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/users/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List products (public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Listed', () => pm.response.to.have.status(200));",
            "const items = pm.response.json();",
            "const list = Array.isArray(items) ? items : (items.items || items.products || []);",
            "if (list.length) pm.collectionVariables.set('productId', list[0].id);"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/catalogue/api/v1/products" }
        },
        {
          "name": "Create category as customer — expect 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Forbidden', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Fail\"\n}" },
            "url": "{{baseUrl}}/catalogue/api/v1/categories"
          }
        },
        {
          "name": "Create category as admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created or validation', () => pm.expect([201, 400]).to.include(pm.response.code));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gadgets\",\n  \"slug\": \"gadgets-{{$timestamp}}\"\n}" },
            "url": "{{baseUrl}}/catalogue/api/v1/categories"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Orders without token — expect 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/orders/api/v1/orders" }
        },
        {
          "name": "Create order (happy path)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Created or bad product', () => pm.expect([201, 400, 502, 503]).to.include(pm.response.code));",
            "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1 }],\n  \"paymentMethod\": \"card\"\n}" },
            "url": "{{baseUrl}}/orders/api/v1/orders"
          }
        },
        {
          "name": "Create order invalid body — expect 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bad request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": []\n}" },
            "url": "{{baseUrl}}/orders/api/v1/orders"
          }
        },
        {
          "name": "List my orders",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Listed', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/orders/api/v1/orders"
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Seed stock",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Seeded', () => pm.expect([200, 201]).to.include(pm.response.code));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 100\n}" },
            "url": "{{inventoryUrl}}/api/v1/stock/{{productId}}/seed"
          }
        },
        {
          "name": "Get stock",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Stock', () => pm.response.to.have.status(200));",
            "pm.expect(pm.response.json()).to.have.property('available');"
          ] } }],
          "request": { "method": "GET", "url": "{{inventoryUrl}}/api/v1/stock/{{productId}}" }
        }
      ]
    },
    {
      "name": "Notification",
      "item": [
        {
          "name": "Inject inventory.updated event",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Accepted', () => pm.expect([200, 202, 204]).to.include(pm.response.code));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"inventory.updated\",\n  \"payload\": { \"productId\": \"{{productId}}\", \"available\": 99 },\n  \"correlationId\": \"postman-test\"\n}" },
            "url": "{{notificationUrl}}/internal/events"
          }
        }
      ]
    }
  ]
}
