{
  "info": {
    "name": "SmartRetailX API (Newman)",
    "description": "Automated API tests + evidence capture across Auth, Catalogue, Orders, Inventory, and Health. Folder order matters — tokens and IDs are chained via environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Auth (user-service)",
      "item": [
        {
          "name": "POST register (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response time < 1500ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "const b = pm.response.json();",
                  "pm.test('Has accessToken + user', () => {",
                  "  pm.expect(b).to.have.property('accessToken');",
                  "  pm.expect(b).to.have.property('user');",
                  "  pm.expect(b.user.role).to.eql('customer');",
                  "});",
                  "pm.environment.set('customerToken', b.accessToken);",
                  "pm.environment.set('customerRefreshToken', b.refreshToken);",
                  "pm.environment.set('customerId', b.user.id);",
                  "pm.environment.set('customerEmail', b.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/users/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.newman.{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Newman Customer\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "POST register (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response time < 1500ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "const b = pm.response.json();",
                  "pm.test('Admin role', () => pm.expect(b.user.role).to.eql('admin'));",
                  "pm.environment.set('adminToken', b.accessToken);",
                  "pm.environment.set('adminRefreshToken', b.refreshToken);",
                  "pm.environment.set('adminId', b.user.id);",
                  "pm.environment.set('adminEmail', b.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/users/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.newman.{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Newman Admin\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "POST login (customer) -> save customerToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 1500ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "const b = pm.response.json();",
                  "pm.test('JWT returned', () => pm.expect(b.accessToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('customerToken', b.accessToken);",
                  "pm.environment.set('customerRefreshToken', b.refreshToken);",
                  "if (b.user && b.user.id) pm.environment.set('customerId', b.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
