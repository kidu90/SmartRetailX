{
  "name": "smartretailx",
  "version": "1.0.0",
  "description": "Cloud-native retail platform microservices monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "gateway"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:user": "npm test --workspace=user-service",
    "test:catalogue": "npm test --workspace=catalogue-service",
    "test:order": "npm test --workspace=order-service",
    "test:gateway": "npm test --workspace=gateway",
    "test:inventory": "npm test --workspace=inventory-service",
    "test:notification": "npm test --workspace=notification-service",
    "test:payment": "npm test --workspace=payment-service",
    "test:auth": "npm test --workspace=@smartretailx/auth-middleware",
    "test:resilient-http": "npm test --workspace=@smartretailx/resilient-http",
    "test:api": "npm --prefix testing/newman install && npm --prefix testing/newman run test:api",
    "test:newman": "npm run test:api",
    "start:user": "npm start --workspace=user-service",
    "start:catalogue": "npm start --workspace=catalogue-service",
    "start:order": "npm start --workspace=order-service",
    "start:gateway": "npm start --workspace=gateway",
    "start:inventory": "npm start --workspace=inventory-service",
    "start:payment": "npm start --workspace=payment-service",
    "start:notification": "npm start --workspace=notification-service",
    "start:frontend": "npm run dev --prefix frontend",
    "test:frontend": "npm test --prefix frontend"
  },

  "engines": {
    "node": ">=18"
  }
}
