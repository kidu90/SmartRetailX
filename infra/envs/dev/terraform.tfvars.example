aws_region         = "ap-south-1"
environment        = "dev"
name_prefix        = "smartretailx-dev"
vpc_cidr           = "10.10.0.0/16"
domain_name        = "dev.smartretailx.example.com"
assets_bucket_name = "smartretailx-dev-assets-CHANGE_ME" # lowercase + hyphens only; must be globally unique
create_route53_zone = true
# wait_for_acm_validation = false   # keep false unless domain NS are delegated to Route53
# alert_email = "you@example.com"   # SNS subscription for CloudWatch alarm emails
# alb_arn_suffix = "app/xxx/yyy"    # set after ALB exists
